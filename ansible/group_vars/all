userinfos:
  allowed_ssh_users: "ansible-admin ansible"
setupinfos:
  lb_master: [ "hl-lb-01" ]
  lb_vip: "192.168.1.13"
  lb_cert_dir: "/etc/haproxy/own-certs"
  maintenance: "FALSE"
  ceph_master: [ "hl-ceph-01", "hl-ceph-05" ]
  ceph_monitor: [ "192.168.1.30", "192.168.1.31", "192.168.1.34" ]
  internal_domain: "hyrsh.io"
  external_domain: "m0rpheus.ch"
  gen_infos: "The Rancher dashboard struggles with CORS and preflight checks."
  haproxy_domains:
    - {domain: "homelab-rpi", ip: [ "homelab-rpi.hyrsh.io:443" ], info: "Homelab Landing Page", state: "up", extra: "no", extraOptions: [], type: "default"}
    - {domain: "grafana", ip: [ "grafana.hyrsh.io:443" ], info: "Metric Visualization", state: "up", extra: "no", extraOptions: [], type: "default"}
    - {domain: "cs2", ip: [ "cs2.hyrsh.io:443" ], info: "Counter-Strike 2 Guides", state: "up", extra: "no", extraOptions: [], type: "default"}
    - {domain: "jellyfin", ip: [ "jellyfin.hyrsh.io:443" ], info: "Home Cinema (friends only)", state: "up", extra: "no", extraOptions: [], type: "default"}
    - {domain: "ceph", ip: [ "ceph.hyrsh.io:443" ], info: "Ceph Dashboard", state: "up", extra: "no", extraOptions: [], type: "default"}
    - {domain: "sftp-ui", ip: [ "sftp-ui.hyrsh.io:443" ], info: "SFTPGo WebUI", state: "up", extra: "yes", extraOptions: ["timeout client 120000","timeout server 120000","timeout connect 120000"], type: "default"}
    - {domain: "alpinefiles", ip: [ "192.168.13.2:443" ], info: "AlpineFiles Instance", state: "up", extra: "no", extraOptions: [], type: "gw-api"}
    - {domain: "rancher", ip: [ "192.168.13.2:443" ], info: "Rancher Dashboard", state: "down", extra: "yes", extraOptions: ["http-request set-header Origin https://rancher.hyrsh.io", "http-request set-header Access-Control-Allow-Origin '*'" ], type: "gw-api"}
  max_connections_haproxy: "100"
  local_dns: "192.168.1.1"
  cronjob_dir: "/opt/central_cronjobs"
  k3s:
    cilium_cli_version: "v0.20.0"
    cilium_version: "1.18.1"
    cilium_arch: "arm64"
    ingress_cert: "wildcard-hyrsh-io"
    ingress_nodes: [ "hl-worker-05", "hl-worker-10" ]
    ingress_nodes_ip: [ "192.168.1.104", "192.168.1.109" ]
    haproxy_ingress_nodes: [ "hl-worker-04", "hl-worker-09" ]
    ingress_instances: 2
    helm_version: "v3.19.0"
    helm_arch: "arm64"
    resource_dir: "/opt/k8s_resources"
    master:
      san_domain: "k3s-master.hyrsh.io"
      registration_host: "hl-master-01"
